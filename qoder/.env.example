# PowerContext Server connection
# The local PowerContext server URL. Default: http://127.0.0.1:18000
POWERCONTEXT_URL=http://127.0.0.1:18000

# Server authentication token (only if PowerContext requires auth)
# Keep this secret. Do not commit real values.
POWERCONTEXT_TOKEN=replace-with-your-token

# PowerContext data directory. Must be inside the project.
# Default: .data/powercontext
POWERCONTEXT_HOME=.data/powercontext

# Application port. Default: 18080
APP_PORT=18080

# PowerContext Server port (used by startup scripts). Default: 18000
PC_PORT=18000
